<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titulo %}{{ titulo }} | {% endif %}{{ site.sigla }} PUC-Rio</title>
  <meta name="description" content="{{ resumo or site.descricao }}">
  <meta property="og:title" content="{{ titulo or site.nome }}">
  <meta property="og:description" content="{{ resumo or site.descricao }}">
  {% if capa %}<meta property="og:image" content="{{ capa }}">{% endif %}
  <link rel="icon" href="{{ site.logo }}">

  <!-- Fontes do Google: Fraunces (títulos) e Source Sans 3 (textos). -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap">

  <link rel="stylesheet" href="/estilos/tokens.css">
  <link rel="stylesheet" href="/estilos/base.css">
  <link rel="stylesheet" href="/estilos/componentes.css">
  <link rel="stylesheet" href="/estilos/paginas.css">
  <script src="/scripts/menu.js" defer></script>
</head>
<body>
  <!-- Link escondido que aparece ao usar Tab: pula direto para o conteúdo. -->
  <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

  {% include "cabecalho.njk" %}

  <main id="conteudo" tabindex="-1"{% if fundo %} class="fundo-{{ fundo }}"{% endif %}>
    {{ content | safe }}
  </main>

  {% include "rodape.njk" %}
</body>
</html>
